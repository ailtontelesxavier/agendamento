# Banco de dados (PostgreSQL async)
# Formato: postgresql+asyncpg://<user>:<password>@<host>:<port>/<dbname>
DATABASE_URL=postgresql+asyncpg://medcare:medcare@localhost:5432/medcare

# Chave secreta para JWT / tokens de autenticação
# Gere um valor seguro em produção: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=CHANGE-ME-IN-PRODUCTION
